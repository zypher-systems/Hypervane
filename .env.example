# 32+ byte secret used to encrypt the Proxmox API token at rest.
# Generate with: openssl rand -base64 32
HYPERVANE_MASTER_KEY=change-me-to-a-long-random-secret

# HTTP
HYPERVANE_HTTP_ADDR=:8080
HYPERVANE_COOKIE_SECURE=false

# Postgres
DATABASE_URL=postgres://hypervane:hypervane@localhost:5432/hypervane?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Production compose (deploy/docker-compose.yml). Images come from ghcr.io.
# POSTGRES_PASSWORD=
# HYPERVANE_COOKIE_SECURE=true
# HYPERVANE_HTTP_PORT=3000
# HYPERVANE_VERSION=latest
